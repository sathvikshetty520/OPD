# Copy this file to .env and fill in real values. .env itself is gitignored.

# Comma-separated station_id:key pairs. Generate real random keys per station --
# do not ship with "dev-key" in any real deployment.
STATION_KEYS=frontdesk1:CHANGE-ME-generate-a-real-key,frontdesk2:CHANGE-ME-generate-a-real-key

# Flask's session/cookie signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=CHANGE-ME

# Set to "false" in any non-local deployment
FLASK_DEBUG=true