# Copy this file to .env and fill in real values. .env itself is gitignored.

# Station credentials are now provisioned per-device via create_station.py,
# not configured here. See "Per-device station credentials" in the README.

# Flask's session/cookie signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=CHANGE-ME

# Set to "false" in any non-local deployment
FLASK_DEBUG=true